{
  "doctype": "DocType",
  "name": "OpenPractice Visit",
  "module": "Open Practice",
  "engine": "InnoDB",
  "field_order": [
    "service_date",
    "patient_first_name",
    "patient_last_name",
    "date_of_birth",
    "administrative_sex",
    "address",
    "city",
    "state",
    "postal_code",
    "member_id",
    "coverage_verified",
    "diagnoses",
    "charges",
    "claim_batch"
  ],
  "fields": [
    {
      "fieldname": "service_date",
      "label": "Service date",
      "fieldtype": "Date",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "patient_first_name",
      "label": "Patient first name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "patient_last_name",
      "label": "Patient last name",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "date_of_birth",
      "label": "Date of birth",
      "fieldtype": "Date",
      "reqd": 1
    },
    {
      "fieldname": "administrative_sex",
      "label": "Administrative sex",
      "fieldtype": "Select",
      "reqd": 1,
      "options": "\nF\nM"
    },
    {
      "fieldname": "address",
      "label": "Patient address",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "city",
      "label": "City",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "state",
      "label": "State",
      "fieldtype": "Data",
      "reqd": 1,
      "default": "CO"
    },
    {
      "fieldname": "postal_code",
      "label": "ZIP code",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "member_id",
      "label": "Medicare beneficiary identifier",
      "fieldtype": "Data",
      "reqd": 1
    },
    {
      "fieldname": "coverage_verified",
      "label": "Primary Medicare Part B coverage verified for this service date",
      "fieldtype": "Check",
      "description": "Confirm coverage using the test case supplied for the run."
    },
    {
      "fieldname": "diagnoses",
      "label": "ICD-10-CM diagnoses",
      "fieldtype": "Data",
      "reqd": 1,
      "description": "Enter the primary diagnosis first, then any additional codes separated by commas."
    },
    {
      "fieldname": "charges",
      "label": "Service lines",
      "fieldtype": "Table",
      "options": "OpenPractice Visit Charge",
      "reqd": 1
    },
    {
      "fieldname": "claim_batch",
      "label": "Released claim batch",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    }
  ],
  "autoname": "OPV-.#########",
  "is_submittable": 1,
  "permissions": [
    {
      "role": "OpenPractice Test Biller",
      "create": 1,
      "read": 1,
      "write": 1,
      "submit": 1
    }
  ]
}

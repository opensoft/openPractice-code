{
  "doctype": "DocType",
  "name": "OpenPractice Claim Batch",
  "module": "Open Practice",
  "engine": "InnoDB",
  "field_order": [
    "visits",
    "claim_count",
    "interchange_control",
    "file_sha256",
    "edi_payload",
    "portal_reference",
    "file_ack",
    "claim_ack",
    "portal_result"
  ],
  "fields": [
    {
      "fieldname": "visits",
      "label": "Finalized visits",
      "fieldtype": "Table",
      "options": "OpenPractice Claim Batch Visit",
      "reqd": 1
    },
    {
      "fieldname": "claim_count",
      "label": "Claim count",
      "fieldtype": "Int",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "interchange_control",
      "label": "Interchange control number",
      "fieldtype": "Data",
      "read_only": 1,
      "unique": 1,
      "no_copy": 1
    },
    {
      "fieldname": "file_sha256",
      "label": "Export SHA-256",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "edi_payload",
      "label": "Frozen 837P",
      "fieldtype": "Long Text",
      "read_only": 1,
      "hidden": 1,
      "no_copy": 1
    },
    {
      "fieldname": "portal_reference",
      "label": "Novitasphere transmission reference",
      "fieldtype": "Data",
      "allow_on_submit": 1,
      "no_copy": 1
    },
    {
      "fieldname": "file_ack",
      "label": "999 file acknowledgment",
      "fieldtype": "Select",
      "options": "Pending\nAccepted\nRejected",
      "default": "Pending",
      "allow_on_submit": 1,
      "no_copy": 1
    },
    {
      "fieldname": "claim_ack",
      "label": "277CA claim acknowledgment",
      "fieldtype": "Select",
      "options": "Pending\nAccepted\nRejected",
      "default": "Pending",
      "allow_on_submit": 1,
      "no_copy": 1,
      "description": "Use Accepted when the 277CA accepts every claim in this batch."
    },
    {
      "fieldname": "portal_result",
      "label": "Portal result",
      "fieldtype": "Data",
      "read_only": 1,
      "allow_on_submit": 1,
      "in_list_view": 1,
      "no_copy": 1
    }
  ],
  "autoname": "OPB-.#########",
  "is_submittable": 1,
  "track_changes": 1,
  "permissions": [
    {
      "role": "OpenPractice Test Biller",
      "create": 1,
      "read": 1,
      "write": 1,
      "submit": 1
    }
  ]
}

{
  "doctype": "DocType",
  "name": "OpenPractice Billing Case",
  "module": "Open Practice",
  "engine": "InnoDB",
  "field_order": [
    "chart_encounter_ref",
    "source_appointment",
    "subscriber_ref",
    "service_date",
    "place_of_service",
    "diagnosis_count",
    "chart_revision",
    "synthetic_roster_sha256",
    "coverage_verified",
    "charges",
    "claim_batch",
    "service_facility_section",
    "service_facility_name",
    "service_facility_address",
    "service_facility_address_2",
    "service_facility_city",
    "service_facility_state",
    "service_facility_postal_code",
    "service_facility_npi"
  ],
  "fields": [
    {
      "fieldname": "chart_encounter_ref",
      "label": "Chart encounter reference",
      "fieldtype": "Data",
      "reqd": 1,
      "unique": 1,
      "in_list_view": 1,
      "description": "Use OC-MOCK for office visits or OC-MOCK-FLU for flu administration, numbered 000001 through 000025."
    },
    {
      "fieldname": "source_appointment",
      "label": "Source appointment",
      "fieldtype": "Data",
      "read_only": 1,
      "no_copy": 1,
      "unique": 1
    },
    {
      "fieldname": "subscriber_ref",
      "label": "Billing subscriber reference",
      "fieldtype": "Data",
      "read_only": 1
    },
    {
      "fieldname": "service_date",
      "label": "Service date",
      "fieldtype": "Date",
      "reqd": 0,
      "in_list_view": 1,
      "read_only": 1
    },
    {
      "fieldname": "place_of_service",
      "label": "Place of service",
      "fieldtype": "Select",
      "options": "\n01\n11\n60",
      "description": "Select 01 (pharmacy) or 60 (mass immunization center) for a flu test. Office cases default to 11."
    },
    {
      "fieldname": "diagnosis_count",
      "label": "Confirmed diagnoses",
      "fieldtype": "Int",
      "read_only": 1
    },
    {
      "fieldname": "chart_revision",
      "label": "Billing facts revision",
      "fieldtype": "Data",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "synthetic_roster_sha256",
      "label": "Approved synthetic roster digest",
      "fieldtype": "Data",
      "hidden": 1,
      "read_only": 1,
      "no_copy": 1
    },
    {
      "fieldname": "coverage_verified",
      "label": "Primary Medicare Part B coverage verified for this service date",
      "fieldtype": "Check",
      "description": "Verify primary coverage using the existing billing subscriber record."
    },
    {
      "fieldname": "charges",
      "label": "Service lines",
      "fieldtype": "Table",
      "options": "OpenPractice Billing Charge",
      "reqd": 1
    },
    {
      "fieldname": "claim_batch",
      "label": "Released claim batch",
      "fieldtype": "Data",
      "read_only": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "service_facility_section",
      "label": "Service facility",
      "fieldtype": "Section Break"
    },
    {
      "fieldname": "service_facility_name",
      "label": "Service facility name",
      "fieldtype": "Data",
      "description": "Enter the facility where the service was performed when it differs from the billing location."
    },
    {
      "fieldname": "service_facility_address",
      "label": "Service facility street address",
      "fieldtype": "Data"
    },
    {
      "fieldname": "service_facility_address_2",
      "label": "Service facility address line 2",
      "fieldtype": "Data"
    },
    {
      "fieldname": "service_facility_city",
      "label": "Service facility city",
      "fieldtype": "Data"
    },
    {
      "fieldname": "service_facility_state",
      "label": "Service facility state",
      "fieldtype": "Data"
    },
    {
      "fieldname": "service_facility_postal_code",
      "label": "Service facility ZIP+4",
      "fieldtype": "Data"
    },
    {
      "fieldname": "service_facility_npi",
      "label": "Service facility NPI",
      "fieldtype": "Data",
      "description": "Enter the facility's own NPI if the test route calls for it."
    }
  ],
  "autoname": "OPC-.#########",
  "is_submittable": 1,
  "permissions": [
    {
      "role": "OpenPractice Test Biller",
      "create": 1,
      "read": 1,
      "write": 1,
      "submit": 1
    }
  ]
}
